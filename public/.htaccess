# Final Sweep – single-page app routing for Apache / Hostinger
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Real files and folders are served as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Missing files with an extension (e.g. a missing .js) return a true 404, not the app shell
  RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]+$
  RewriteRule ^ - [L]
  # Everything else is a client-side route
  RewriteRule ^ /index.html [L]
</IfModule>
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
